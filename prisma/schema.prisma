
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Usuario {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  nome      String?
  senhaHash String
}

model Filme {
  id      Int      @id @default(autoincrement())
  titulo  String
  imagem  String // Campo renomeado de caminhoDaImagem
  sessoes Sessao[]
}

model Sessao {
  id               Int      @id @default(autoincrement())
  local            String
  data             DateTime
  horarios         String
  tipo             String
  filmeId          Int
  filme            Filme    @relation(fields: [filmeId], references: [id])
  
  // Novos campos para reserva
  assentosOcupados String   @default("[]") // Armazena um JSON array de strings: ["A1", "B2"]
  reservas         Reserva[]
}

model Reserva {
  id          Int    @id @default(autoincrement())
  nomeCliente String
  assentos    String // Armazena um JSON array de strings: ["A1", "B2"]
  sessaoId    Int
  sessao      Sessao @relation(fields: [sessaoId], references: [id])
}
